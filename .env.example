# Unique identity for this deployed Minecraft server.
SERVER_KEY=
AGENT_PORT=
# Optional override; defaults to http://127.0.0.1:<AGENT_PORT>.
MCLINK_AGENT_URL=

# PilotMC Core connection.
BACKEND_URL=
BACKEND_API_TOKEN=

# PostgreSQL connection.
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=
PGSSL=

# Optional Bedrock executable override.
BDS_BINARY=
BDS_WORLD_NAME=Bedrock level

# Required to use the instance's local web command controls.
WEB_ADMIN_TOKEN=
